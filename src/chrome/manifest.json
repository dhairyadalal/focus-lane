{
  "manifest_version": 3,
  "name": "Focus Lane",
  "version": "0.1.0",
  "description": "A local task queue and focus timer in Chrome's side panel.",
  "permissions": ["sidePanel", "storage", "alarms"],
  "action": {
    "default_title": "Open Focus Lane"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
